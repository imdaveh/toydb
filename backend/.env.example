# Copy to .env and fill in values
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=toydb

# Use long random secrets in production
ACCESS_TOKEN_SECRET=change_this_access_secret
REFRESH_TOKEN_SECRET=change_this_refresh_secret
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# Frontend origin(s) for CORS. Separate multiple origins with commas.
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=https://mntoyhunters.com,https://www.mntoyhunters.com
PORT=4000

# Absolute path to a directory for storing uploaded photos. In production, point
# this outside the deployed code directory (e.g. a persistent folder on the host)
# so uploaded photos survive future deployments. Defaults to backend/uploads.
UPLOADS_DIR=/home/your-user/toydb-uploads
